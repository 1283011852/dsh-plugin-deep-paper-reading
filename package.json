    "paper-reading",
    "literature",
    "biomedical",
    "mermaid",
    "flowchart",
    "diagram",
    "docx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1283011852/dsh-plugin-deep-paper-reading.git"
  },
  "homepage": "https://github.com/1283011852/dsh-plugin-deep-paper-reading",
  "bugs": {
    "url": "https://github.com/1283011852/dsh-plugin-deep-paper-reading/issues"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "presets",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
